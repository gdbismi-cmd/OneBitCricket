<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="SliderPreference">
        <attr name="min" format="integer" />
        <attr name="max" format="integer" />
        <attr name="display" format="enum">
            <enum name="percent" value="0" />
            <enum name="hour" value="1" />
            <enum name="minutes" value="2" />
            <enum name="count" value="3" />
            <enum name="wind" value="4" />
        </attr>
    </declare-styleable>
</resources>
